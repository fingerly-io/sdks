{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // No rootDir/outDir: tsup builds this package, and `tsc` is only ever run
    // as a typechecker (`noEmit`).
    "noEmit": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    // The automatic runtime, so a file using JSX does not also have to import
    // React to satisfy a transform nobody has needed since React 17.
    "jsx": "react-jsx"
  },
  "include": ["src", "tests"]
}
