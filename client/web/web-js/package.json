{
  "name": "@fingerly/web-js",
  "version": "0.1.1",
  "publishConfig": { "access": "public" },
  "description": "Vanilla browser JavaScript SDK",
  "license": "Apache-2.0",
  "repository": {"type": "git", "url": "https://github.com/fingerly-io/sdks.git", "directory": "client/web/web-js"},
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/browser.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "dependencies": {
    "@fingerly/core": "workspace:*"
  },
  "scripts": {
    "build": "tsup",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "demo": "node demo/serve.mjs"
  },
  "devDependencies": {
    "happy-dom": "^15.11.7",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
