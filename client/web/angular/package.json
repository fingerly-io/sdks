{
  "name": "@fingerly/angular",
  "version": "0.1.0",
  "private": true,
  "description": "Angular bindings for the Fingerly SDK",
  "license": "Apache-2.0",
  "repository": {"type": "git", "url": "https://github.com/fingerly-io/sdks.git", "directory": "client/web/angular"},
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "dependencies": {
    "@fingerly/web-js": "workspace:*"
  },
  "peerDependencies": {
    "@angular/core": ">=19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "playground": "vite --config playground/vite.config.ts",
    "demo": "vite --config playground/vite.config.ts"
  },
  "devDependencies": {
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "happy-dom": "^15.11.7",
    "rxjs": "^7.8.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  }
}
