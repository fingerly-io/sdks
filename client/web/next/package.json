{
  "name": "@fingerly/next",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js integration wrapping @fingerly/react",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "dependencies": {
    "@fingerly/node": "workspace:*",
    "@fingerly/react": "workspace:*"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=19"
  },
  "scripts": {
    "build": "tsup",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "demo": "tsup && next dev demo --port 4178"
  },
  "devDependencies": {
    "@fingerly/web-js": "workspace:*",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^15.11.7",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
