{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // No rootDir/outDir: tsup builds this package, and `tsc` is only ever run
    // as a typechecker (`noEmit`).
    "noEmit": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx"
  },
  "include": ["src", "tests"]
}
