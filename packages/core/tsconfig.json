{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // No rootDir/outDir: tsup builds this package, and `tsc` is only ever run
    // as a typechecker (`noEmit`). Declaring a rootDir that the tests sit
    // outside of makes tsc reject the very files it is being asked to check.
    "noEmit": true,

    // WebWorker rather than DOM, and this is load-bearing rather than
    // incidental. This package uses the web-standard globals that exist
    // everywhere it runs - fetch, AbortController, TextEncoder, timers,
    // performance - but must never touch `document` or `window`, because
    // @fingerly/node depends on it. The worker lib
    // is exactly that set: every global this package is allowed to use, and
    // none of the ones it is not. A `document.` typo fails the build here
    // instead of failing at runtime inside a customer's Node process.
    "lib": ["ES2020", "WebWorker"]
  },
  "include": ["src", "tests"]
}
