# No dependency runs an install script.
#
# esbuild's postinstall is the one that forces this. It shells out to the
# binary it just placed and compares the reported version against its own
# package.json - but several esbuild versions arrive here at once (vitest's
# vite pulls one, tsup pulls another), they share a hoisted .bin, and whichever
# finishes first wins it. The later one then reads the earlier one's version
# and fails the entire install with "Expected 0.28.2 but got 0.27.7".
#
# The check is only a self-test. The binary esbuild actually executes comes
# from the @esbuild/<platform> optional dependency, which pnpm installs either
# way, so skipping the script costs nothing - `pnpm build` is the proof.
#
# Set as a blanket rule rather than per-package so that a new dependency cannot
# quietly start running code at install time.
ignore-scripts=true
