{
  "name": "@badele/react-native",
  "version": "0.0.0",
  "private": true,
  "description": "React Native SDK — a bridge to the native iOS and Android SDKs, which do the collecting",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "ios", "android", "badele-react-native.podspec"],
  "sideEffects": false,
  "dependencies": {
    "@badele/core": "workspace:*"
  },
  "peerDependencies": {
    "react-native": ">=0.73"
  },
  "scripts": {
    "build": "tsup",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
